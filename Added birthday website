<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Happy Birthday My Love 💕</title>

<style>
body{
  margin:0;
  padding:0;
  font-family: 'Segoe UI', cursive;
  background: linear-gradient(to bottom right, #ffd6e8, #ffeef7);
  text-align:center;
  overflow:hidden;
}

/* Floating hearts animation */
.heart{
  position:absolute;
  color:#ff69b4;
  font-size:20px;
  animation:float 6s linear infinite;
}

@keyframes float{
  0%{transform:translateY(100vh);}
  100%{transform:translateY(-10vh);}
}

/* Center Card */
.card{
  background:white;
  width:280px;
  padding:25px;
  border-radius:25px;
  margin:120px auto;
  box-shadow:0 10px 25px rgba(0,0,0,0.15);
  transition:0.5s;
}

h1{
  color:#ff4d88;
  font-size:22px;
}

button{
  padding:10px 20px;
  border:none;
  border-radius:25px;
  background:#ffb6c1;
  color:white;
  font-size:16px;
  cursor:pointer;
  margin-top:15px;
  transition:0.3s;
}

button:hover{
  background:#ff4d88;
}

/* Hidden Surprise Section */
#surprise{
  display:none;
  margin-top:20px;
  animation:fadeIn 1.5s;
}

@keyframes fadeIn{
  from{opacity:0;}
  to{opacity:1;}
}

.message{
  color:#ff4d88;
  font-size:18px;
  margin-top:15px;
}
</style>
</head>

<body>

<!-- Floating Hearts -->
<div class="heart" style="left:10%;">💗</div>
<div class="heart" style="left:30%; animation-delay:2s;">💕</div>
<div class="heart" style="left:50%; animation-delay:4s;">💖</div>
<div class="heart" style="left:70%; animation-delay:1s;">💞</div>
<div class="heart" style="left:85%; animation-delay:3s;">💘</div>

<!-- Main Card -->
<div class="card">
  <h1>Happy Birthday 💕<br>My Love Bhavesh</h1>
  <button onclick="showSurprise()">Click for Surprise 🎁</button>

  <div id="surprise">
    <div class="message">
      From the moment you came into my life,  
      everything became brighter ✨  
      You are my happiness, my safe place,  
      my forever person 🥹💖  
      I love you more than words can explain 💕  
      Happy Birthday My Ghadedo 🎂❤️
    </div>
  </div>
</div>

<script>
function showSurprise(){
  document.getElementById("surprise").style.display="block";
}
</script>

</body>
</html>
